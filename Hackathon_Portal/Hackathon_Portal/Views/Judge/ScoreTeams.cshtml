@model Hackathon_Portal.Models.Hackathon
@{
    ViewData["Title"] = "Score Teams - " + Model.Title;
    Layout = "~/Views/_JudgeLayout.cshtml";
    var judgeId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="MyHackathons" class="text-decoration-none text-navy fw-bold small">
            <i class="fas fa-arrow-left me-1"></i> Back to My Hackathons
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; background-color: #fff;">
        <div class="card-body p-4 d-flex align-items-center gap-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                <i class="fas fa-star fs-4 text-info"></i>
            </div>
            <div>
                <h4 class="m-0 fw-bold" style="font-family: 'Poppins', sans-serif; color: #1C2B3A;">@Model.Title</h4>
                <p class="m-0 small text-muted">Score each team (0-10 per category)</p>
            </div>
        </div>
    </div>

    @if (Model.Teams == null || !Model.Teams.Any())
    {
        <div class="text-center p-5 bg-white rounded shadow-sm border border-light">
            <i class="fas fa-users text-muted bg-light rounded-circle p-4 mb-3" style="font-size: 32px;"></i>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No Teams Yet</h5>
            <p class="text-muted">No teams have registered for this hackathon yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var team in Model.Teams)
            {
                var existingScore = team.Scores?.FirstOrDefault(s => s.JudgeId == judgeId);
                var isScored = existingScore != null;
                var scoredBorderClass = isScored ? "border-start border-4 border-success" : "border border-light";

                <div class="col-12">
                    <div class="card shadow-sm @scoredBorderClass" style="border-radius: 12px;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold text-navy m-0" style="font-family: 'Poppins', sans-serif;">@team.TeamName</h5>
                                    <p class="text-orange fw-bold small mb-1"><i class="fas fa-project-diagram me-1"></i> @team.ProjectTitle</p>
                                    <p class="text-muted small mb-2">@team.ProjectDescription</p>
                                    <p class="text-muted small mb-0 d-flex align-items-center gap-3">
                                        <span><i class="fas fa-user-circle me-1"></i> Leader: @team.Leader?.FullName</span>
                                        @if (team.Members != null && team.Members.Any())
                                        {
                                            <span><i class="fas fa-users me-1"></i> @team.Members.Count members</span>
                                        }
                                    </p>
                                </div>
                                @if (isScored)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                        <i class="fas fa-check me-1"></i> Scored: @(existingScore!.Innovation + existingScore.Execution + existingScore.Presentation)/30
                                    </span>
                                }
                            </div>

                            <!-- Scoring Form -->
                            <form asp-action="SubmitScore" method="post" class="border-top pt-4" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="TeamId" value="@team.Id" />
                                <input type="hidden" name="HackathonId" value="@Model.Id" />

                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-navy small d-block text-center">
                                            <i class="fas fa-lightbulb text-warning me-1"></i> Innovation (0-10)
                                        </label>
                                        <input type="number" name="Innovation" 
                                               data-val="true" data-val-required="Score is required" 
                                               data-val-range="Must be between 0 and 10" data-val-range-min="0" data-val-range-max="10"
                                               value="@(existingScore?.Innovation ?? 0)"
                                               class="form-control form-control-lg bg-light text-center fw-bold fs-4" />
                                        <span class="text-danger small mt-1 text-center d-block w-100 score-validation" style="display: none;"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-navy small d-block text-center">
                                            <i class="fas fa-cog text-info me-1"></i> Execution (0-10)
                                        </label>
                                        <input type="number" name="Execution" 
                                               data-val="true" data-val-required="Score is required" 
                                               data-val-range="Must be between 0 and 10" data-val-range-min="0" data-val-range-max="10"
                                               value="@(existingScore?.Execution ?? 0)"
                                               class="form-control form-control-lg bg-light text-center fw-bold fs-4" />
                                        <span class="text-danger small mt-1 text-center d-block w-100 score-validation" style="display: none;"></span>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold text-navy small d-block text-center">
                                            <i class="fas fa-presentation-screen text-primary me-1"></i> Presentation (0-10)
                                        </label>
                                        <input type="number" name="Presentation" 
                                               data-val="true" data-val-required="Score is required" 
                                               data-val-range="Must be between 0 and 10" data-val-range-min="0" data-val-range-max="10"
                                               value="@(existingScore?.Presentation ?? 0)"
                                               class="form-control form-control-lg bg-light text-center fw-bold fs-4" />
                                        <span class="text-danger small mt-1 text-center d-block w-100 score-validation" style="display: none;"></span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-navy small">Feedback (Optional)</label>
                                    <textarea name="Feedback" rows="2" placeholder="Add constructive feedback for this team..."
                                              class="form-control bg-light text-sm">@existingScore?.Feedback</textarea>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-info px-4 rounded-pill text-white fw-bold">
                                        <i class="fas fa-save me-1"></i> @(isScored ? "Update Score" : "Submit Score")
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Manual validation for 0-10 scoring
            $('form[action*="SubmitScore"]').on('submit', function(e) {
                let isValid = true;
                
                $(this).find('input[type="number"]').each(function() {
                    let val = parseInt($(this).val());
                    let errorSpan = $(this).siblings('.score-validation');
                    
                    if (isNaN(val) || val < 0 || val > 10) {
                        isValid = false;
                        $(this).addClass('is-invalid');
                        errorSpan.text('Score must be between 0 and 10').show();
                    } else {
                        $(this).removeClass('is-invalid');
                        errorSpan.text('').hide();
                    }
                });

                if (!isValid) {
                    e.preventDefault(); // Stop submission if invalid
                }
            });

            // Clear errors on typing
            $('input[type="number"]').on('input', function() {
                let val = parseInt($(this).val());
                if (!isNaN(val) && val >= 0 && val <= 10) {
                    $(this).removeClass('is-invalid');
                    $(this).siblings('.score-validation').text('').hide();
                }
            });
        });
    </script>
}
