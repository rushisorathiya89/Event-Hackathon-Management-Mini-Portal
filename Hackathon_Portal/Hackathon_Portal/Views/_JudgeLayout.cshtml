<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Judge Panel</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Custom RKU CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar d-none d-md-block" id="sidebar">
        <div class="sidebar-header">
            <h5 class="text-white m-0" style="font-family: 'Poppins'; font-weight: 700;">
                <i class="fas fa-bolt text-orange me-2"></i>HackPortal
            </h5>
            <div style="color: #17A2B8; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-top: 5px;">Judge Panel</div>
        </div>
        <div class="py-3">
            <a asp-action="Dashboard" asp-controller="Judge" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Dashboard" ? "active-judge" : "")">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a asp-action="MyHackathons" asp-controller="Judge" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "MyHackathons" ? "active-judge" : "")">
                <i class="fas fa-calendar-check"></i> My Hackathons
            </a>
            <a asp-action="ScoreTeams" asp-controller="Judge" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "ScoreTeams" ? "active-judge" : "")">
                <i class="fas fa-star"></i> Score Teams
            </a>
            <a asp-action="Results" asp-controller="Judge" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Results" ? "active-judge" : "")">
                <i class="fas fa-chart-bar"></i> Results
            </a>
            <a asp-controller="Notification" asp-action="All" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "All" ? "active-judge" : "")">
                <i class="fas fa-bell"></i> Notifications
            </a>
            <hr style="border-color: rgba(255,255,255,0.1); margin: 15px 20px;">
            <a asp-controller="Account" asp-action="Logout" class="sidebar-link text-danger">
                <i class="fas fa-sign-out-alt text-danger"></i> Logout
            </a>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="d-flex align-items-center">
                <button class="btn btn-outline-primary d-md-none me-3" type="button" onclick="document.getElementById('sidebar').classList.toggle('show')">
                    <i class="fas fa-bars"></i>
                </button>
                <h4 class="m-0" style="color: #1C2B3A; font-family: 'Poppins';">@ViewData["Title"]</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                @await Html.PartialAsync("~/Views/Shared/_NotificationBell.cshtml")
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; border: 1px solid #E8ECF0;">
                        <i class="fas fa-gavel text-info"></i>
                    </div>
                    <div class="d-none d-sm-block">
                        <div style="font-weight: 600; font-size: 14px; color: #1C2B3A; line-height: 1;">@Context.Session.GetString("UserName")</div>
                        <div style="font-size: 11px; color: #718096;">Judge</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Render Body -->
        <div class="container-fluid p-0">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success d-flex align-items-center mb-4 border-0" style="background: #E8F5E9; color: #2E7D32;">
                    <i class="fas fa-check-circle me-3 fs-5"></i>
                    <div>@TempData["Success"]</div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4 border-0" style="background: #FFEBEE; color: #C62828;">
                    <i class="fas fa-exclamation-circle me-3 fs-5"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }
            
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            @RenderBody()
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
