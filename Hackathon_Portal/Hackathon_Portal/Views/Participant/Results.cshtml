@model Hackathon_Portal.Models.Hackathon
@{
    ViewData["Title"] = "Results - " + Model.Title;
    Layout = "~/Views/_ParticipantLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="MyHackathons" class="text-decoration-none text-success" style="font-weight: 500;">
            <i class="fas fa-arrow-left me-1"></i> Back to My Hackathons
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border-left: 4px solid #1A2B4A !important;">
        <div class="card-body p-4 d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                <i class="fas fa-trophy fs-3"></i>
            </div>
            <div>
                <h3 class="fw-bold text-navy m-0" style="font-family: 'Poppins', sans-serif;">@Model.Title &mdash; Leaderboard</h3>
                <p class="text-muted m-0 small">Rankings based on judge scores</p>
            </div>
        </div>
    </div>

    @if (Model.Teams == null || !Model.Teams.Any())
    {
        <div class="text-center p-5 bg-white rounded shadow-sm border border-light">
            <div class="d-inline-flex bg-light rounded-circle p-4 mb-3">
                <i class="fas fa-users-slash text-muted" style="font-size: 32px;"></i>
            </div>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No Teams Registered Yet</h5>
            <p class="text-muted">No teams registered.</p>
        </div>
    }
    else
    {
        var rankedTeams = Model.Teams
            .Select(t => new {
                Team = t,
                Total = t.Scores != null && t.Scores.Any()
                    ? t.Scores.Sum(s => s.Innovation + s.Execution + s.Presentation) : 0,
                Scored = t.Scores != null && t.Scores.Any()
            })
            .OrderByDescending(x => x.Total)
            .ToList();

        <!-- Top 3 Podium -->
        @if (rankedTeams.Count >= 3 && rankedTeams.Take(3).All(x => x.Scored))
        {
            <div class="row g-4 mb-5 align-items-end justify-content-center mt-2 px-md-5">
                <!-- 2nd Place -->
                <div class="col-4 col-md-3">
                    <div class="card border-2 shadow-sm text-center h-100" style="border-radius: 16px; border-color: #e2e8f0; border-bottom-width: 8px;">
                        <div class="card-body p-3 p-md-4">
                            <div class="display-4 mb-2">🥈</div>
                            <h5 class="fw-bold text-navy text-truncate" style="font-family: 'Poppins', sans-serif;" title="@rankedTeams[1].Team.TeamName">@rankedTeams[1].Team.TeamName</h5>
                            <p class="fs-3 fw-bold text-primary m-0 mt-2">@rankedTeams[1].Total</p>
                            <p class="text-muted small m-0 text-uppercase" style="letter-spacing: 1px;">points</p>
                        </div>
                    </div>
                </div>
                <!-- 1st Place -->
                <div class="col-4 col-md-4" style="z-index: 10;">
                    <div class="card border-2 shadow-lg text-center h-100" style="border-radius: 16px; border-color: #ffd700; border-bottom-width: 8px; background: linear-gradient(135deg, #fffcf0 0%, #fff8d6 100%); transform: scale(1.05);">
                        <div class="card-body p-3 p-md-4 py-md-5">
                            <div class="display-2 mb-2">🥇</div>
                            <h4 class="fw-bold text-navy text-truncate" style="font-family: 'Poppins', sans-serif;" title="@rankedTeams[0].Team.TeamName">@rankedTeams[0].Team.TeamName</h4>
                            <p class="display-5 fw-bold text-warning m-0 mt-2" style="text-shadow: 1px 1px 0 rgba(0,0,0,0.1);">@rankedTeams[0].Total</p>
                            <p class="text-muted small m-0 fw-bold text-uppercase" style="letter-spacing: 1px;">points</p>
                        </div>
                    </div>
                </div>
                <!-- 3rd Place -->
                <div class="col-4 col-md-3">
                    <div class="card border-2 shadow-sm text-center h-100" style="border-radius: 16px; border-color: #cd7f32; border-bottom-width: 8px; background-color: #fdfaf6;">
                        <div class="card-body p-3 p-md-4">
                            <div class="display-4 mb-2">🥉</div>
                            <h5 class="fw-bold text-navy text-truncate" style="font-family: 'Poppins', sans-serif;" title="@rankedTeams[2].Team.TeamName">@rankedTeams[2].Team.TeamName</h5>
                            <p class="fs-3 fw-bold text-primary m-0 mt-2">@rankedTeams[2].Total</p>
                            <p class="text-muted small m-0 text-uppercase" style="letter-spacing: 1px;">points</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3 fw-bold border-0">Rank</th>
                            <th class="py-3 fw-bold border-0">Team</th>
                            <th class="py-3 fw-bold border-0">Project</th>
                            <th class="pe-4 py-3 fw-bold border-0 text-center">Score</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @{ int rank = 1; }
                        @foreach (var item in rankedTeams)
                        {
                            <tr class="transition">
                                <td class="ps-4 py-3">
                                    @if (rank == 1) { <span class="fs-4">🥇</span> }
                                    else if (rank == 2) { <span class="fs-4">🥈</span> }
                                    else if (rank == 3) { <span class="fs-4">🥉</span> }
                                    else { <span class="badge bg-secondary rounded-pill">#@rank</span> }
                                </td>
                                <td class="py-3 fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">@item.Team.TeamName</td>
                                <td class="py-3 text-muted small">@item.Team.ProjectTitle</td>
                                <td class="pe-4 py-3 text-center">
                                    @if (item.Scored)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded shadow-sm fw-bold" style="width: 45px; height: 45px; font-size: 1.1rem;">
                                            @item.Total
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill fw-normal">Pending</span>
                                    }
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
