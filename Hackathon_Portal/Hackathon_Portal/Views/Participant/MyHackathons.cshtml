@model List<Hackathon_Portal.Models.Team>
@{
    ViewData["Title"] = "My Hackathons";
    Layout = "~/Views/_ParticipantLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h3 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">My Hackathons</h3>
        <p class="text-muted small m-0">Hackathons you have registered for</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center p-5 bg-white rounded shadow-sm border border-light">
            <div class="d-inline-flex bg-light rounded-circle p-4 mb-3">
                <i class="fas fa-clipboard text-muted" style="font-size: 32px;"></i>
            </div>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No Registrations Yet</h5>
            <p class="text-muted mb-4">Browse available hackathons and apply!</p>
            <a asp-action="Hackathons" class="btn btn-primary px-4 py-2" style="background-color: #F4821F; border-color: #F4821F;">
                <i class="fas fa-search me-1"></i> Browse Hackathons
            </a>
        </div>
    }
    else
    {
        <!-- Search & Filter Bar -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-md-7 col-lg-8 position-relative">
                        <i class="fas fa-search position-absolute text-muted" style="left: 20px; top: 50%; transform: translateY(-50%);"></i>
                        <input type="text" id="searchInput" placeholder="Search by hackathon, team name, or project..."
                               class="form-control form-control-lg bg-light ps-5 border-0" />
                    </div>
                    <div class="col-md-5 col-lg-4 d-flex align-items-center gap-3">
                        <select id="scoreFilter" class="form-select form-select-lg bg-light border-0 flex-grow-1">
                            <option value="">All Status</option>
                            <option value="scored">Scored</option>
                            <option value="pending">Pending</option>
                        </select>
                        <span id="resultCount" class="badge bg-navy rounded-pill py-2 px-3">@Model.Count registrations</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="noResults" class="d-none text-center p-5 bg-white rounded shadow-sm border border-light mb-4">
            <i class="fas fa-search text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No matching registrations</h5>
            <p class="text-muted small">Try a different search or filter</p>
        </div>

        <div class="row g-4" id="teamList">
            @foreach (var team in Model)
            {
                var hasScores = team.Scores != null && team.Scores.Any();
                var totalScore = hasScores ? team.Scores!.Sum(s => s.Innovation + s.Execution + s.Presentation) : 0;

                <div class="col-12 team-card"
                     data-hackathon="@(team.Hackathon?.Title?.ToLower() ?? "")"
                     data-team="@team.TeamName.ToLower()"
                     data-project="@(team.ProjectTitle?.ToLower() ?? "")"
                     data-scored="@(hasScores ? "scored" : "pending")">
                    <div class="card border-0 shadow-sm hover-shadow transition h-100" style="border-radius: 12px; border-left: 4px solid @(hasScores ? "#28A745" : "#1A2B4A") !important;">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <h5 class="fw-bold text-navy m-0" style="font-family: 'Poppins', sans-serif;">@team.Hackathon?.Title</h5>
                                        @if (hasScores)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Scored</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning text-dark border border-warning border-opacity-25">Pending</span>
                                        }
                                    </div>
                                    <p class="text-navy fw-medium mb-1"><i class="fas fa-users text-orange me-2"></i> Team: @team.TeamName</p>
                                    <p class="text-primary small mb-3"><i class="fas fa-project-diagram me-2"></i> @team.ProjectTitle</p>
                                    
                                    @if (team.Members != null && team.Members.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @foreach (var m in team.Members)
                                            {
                                                <span class="badge bg-light text-navy border font-monospace fw-normal" style="font-size: 0.75rem;">@m.MemberName</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end">
                                    @if (hasScores)
                                    {
                                        <div class="d-inline-flex flex-column align-items-center bg-primary bg-opacity-10 p-3 rounded" style="min-width: 100px;">
                                            <span class="fs-2 fw-bold text-navy">@totalScore</span>
                                            <span class="text-muted small">Total Score / 30</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex flex-column align-items-center p-3">
                                            <i class="fas fa-clock text-warning fs-3 mb-2"></i>
                                            <span class="text-muted small">Awaiting Review</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Applied on @team.Hackathon?.RegistrationDeadline.ToString("MMM dd, yyyy")</span>
                                <a asp-action="Results" asp-route-id="@team.HackathonId" class="btn btn-sm btn-outline-primary fw-bold px-3">
                                    <i class="fas fa-trophy me-1"></i> View Results
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById('searchInput');
            const scoreFilter = document.getElementById('scoreFilter');
            const cards = document.querySelectorAll('.team-card');
            const noResults = document.getElementById('noResults');
            const resultCount = document.getElementById('resultCount');

            function filterRegistrations() {
                const query = (searchInput.value || "").toLowerCase().trim();
                const status = scoreFilter.value || "";
                let visibleCount = 0;

                cards.forEach(card => {
                    const hackathon = (card.dataset.hackathon || "");
                    const team = (card.dataset.team || "");
                    const project = (card.dataset.project || "");
                    const scoredStatus = card.dataset.scored || "";

                    const matchSearch = !query || hackathon.includes(query) || team.includes(query) || project.includes(query);
                    const matchStatus = !status || scoredStatus === status;

                    if (matchSearch && matchStatus) {
                        card.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        card.classList.add('d-none');
                    }
                });

                if (noResults) {
                    if (visibleCount === 0 && cards.length > 0) {
                        noResults.classList.remove('d-none');
                    } else {
                        noResults.classList.add('d-none');
                    }
                }
                if (resultCount) resultCount.textContent = visibleCount + (visibleCount === 1 ? ' registration' : ' registrations');
            }

            if(searchInput) searchInput.addEventListener('input', filterRegistrations);
            if(scoreFilter) scoreFilter.addEventListener('change', filterRegistrations);

            // Initial filter
            filterRegistrations();
        });
    </script>
}
