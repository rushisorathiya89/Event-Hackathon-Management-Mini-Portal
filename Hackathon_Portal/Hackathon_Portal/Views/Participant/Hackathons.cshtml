@model List<Hackathon_Portal.Models.Hackathon>
@{
    ViewData["Title"] = "Browse Hackathons";
    Layout = "~/Views/_ParticipantLayout.cshtml";
    var appliedIds = ViewBag.AppliedIds as List<int> ?? new List<int>();
    var now = (DateTime)(ViewBag.Now ?? DateTime.Now);
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h3 class="m-0 fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">Available Hackathons</h3>
        <p class="text-muted m-0 small">Browse and register for published hackathons</p>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3">
                <div class="col-md-7 col-lg-8 position-relative">
                    <i class="fas fa-search position-absolute text-muted" style="left: 20px; top: 50%; transform: translateY(-50%);"></i>
                    <input type="text" id="searchInput" placeholder="Search by title or tech stack..."
                           class="form-control form-control-lg bg-light ps-5 border-0" />
                </div>
                <div class="col-md-5 col-lg-4 d-flex align-items-center gap-3">
                    <select id="regFilter" class="form-select form-select-lg bg-light border-0 flex-grow-1">
                        <option value="">All Regions</option>
                        <option value="open">Open for Registration</option>
                        <option value="closed">Registration Closed</option>
                        <option value="applied">Applied</option>
                    </select>
                    <span id="resultCount" class="badge bg-navy rounded-pill align-self-center py-2 px-3 fw-bold">@Model.Count</span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="text-center p-5 bg-white rounded shadow-sm border border-light">
            <div class="d-inline-flex bg-light rounded-circle p-4 mb-3">
                <i class="fas fa-calendar-xmark text-muted" style="font-size: 32px;"></i>
            </div>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No Hackathons Available</h5>
            <p class="text-muted">Check back soon for new events!</p>
        </div>
    }
    else
    {
        <!-- No Results Message -->
        <div id="noResults" class="d-none text-center p-5 bg-white rounded shadow-sm border border-light mb-4">
            <i class="fas fa-search text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No matching hackathons</h5>
            <p class="text-muted small">Try a different search or filter</p>
        </div>

        <div class="row g-4" id="hackathonGrid">
            @foreach (var h in Model)
            {
                var isApplied = appliedIds.Contains(h.Id);
                var isDeadlinePassed = now > h.RegistrationDeadline;
                var regStatus = isApplied ? "applied" : isDeadlinePassed ? "closed" : "open";
                var opacityClass = isDeadlinePassed && !isApplied ? "opacity-75" : "";

                <div class="col-12 col-md-6 col-xxl-4 hackathon-card @opacityClass"
                     data-title="@h.Title.ToLower()"
                     data-tech="@(h.TechStack?.ToLower() ?? "")"
                     data-reg="@regStatus">
                    <div class="card h-100 border-0 shadow-sm hover-shadow transition" style="border-radius: 12px;">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-success bg-opacity-10 shadow-sm rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="fas fa-code text-success fs-5"></i>
                                </div>
                                @if (isApplied)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1"><i class="fas fa-check me-1"></i> Applied</span>
                                }
                                else if (isDeadlinePassed)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                        <i class="fas fa-lock me-1"></i>Closed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Open</span>
                                }
                            </div>

                            <h5 class="fw-bold text-navy mb-2" style="font-family: 'Poppins', sans-serif;">@h.Title</h5>
                            <p class="text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">@h.Description</p>

                            @if (!string.IsNullOrEmpty(h.TechStack))
                            {
                                <div class="mt-2 mb-3 d-flex flex-wrap gap-1">
                                    @foreach (var tech in h.TechStack.Split(','))
                                    {
                                        <span class="badge bg-light text-success border font-monospace fw-normal">@tech.Trim()</span>
                                    }
                                </div>
                            }

                            <div class="mt-auto pt-3 border-top pb-3 text-muted small">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-calendar-alt text-orange me-2" style="width: 16px;"></i>
                                        <span>@h.StartDate.ToString("MMM dd") - @h.EndDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-clock text-orange me-2" style="width: 16px;"></i>
                                        <span>Deadline: <span class="@(isDeadlinePassed ? "text-danger fw-bold" : "text-success fw-bold")">@h.RegistrationDeadline.ToString("MMM dd, yyyy")</span></span>
                                        @if (!isDeadlinePassed)
                                        {
                                            var daysLeft = (h.RegistrationDeadline - now).Days;
                                            if (daysLeft <= 3)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">@daysLeft day@(daysLeft != 1 ? "s" : "") left!</span>
                                            }
                                        }
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-users text-orange me-2" style="width: 16px;"></i>
                                        <span>Max @h.MaxTeamSize members &bull; @(h.Teams?.Count ?? 0) teams</span>
                                    </div>
                                </div>
                            </div>

                            @if (isApplied)
                            {
                                <a asp-action="Results" asp-route-id="@h.Id"
                                   class="btn btn-outline-primary w-100 fw-bold mt-2 pb-2 pt-2">
                                    <i class="fas fa-trophy me-1"></i> View Results
                                </a>
                            }
                            else if (isDeadlinePassed)
                            {
                                <button disabled class="btn btn-light text-muted w-100 fw-bold mt-2 pb-2 pt-2" style="cursor: not-allowed;">
                                    <i class="fas fa-lock me-1"></i> Registration Closed
                                </button>
                            }
                            else
                            {
                                <a asp-action="Apply" asp-route-id="@h.Id"
                                   class="btn btn-success w-100 fw-bold mt-2 pb-2 pt-2 shadow-sm" style="background-color: #28a745; border-color: #28a745;">
                                    <i class="fas fa-rocket me-1"></i> Apply Now
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById('searchInput');
            const regFilter = document.getElementById('regFilter');
            const cards = document.querySelectorAll('.hackathon-card');
            const noResults = document.getElementById('noResults');
            const resultCount = document.getElementById('resultCount');

            function filterCards() {
                const query = (searchInput.value || "").toLowerCase().trim();
                const reg = regFilter.value || "";
                let visibleCount = 0;

                cards.forEach(card => {
                    const title = (card.dataset.title || "").toLowerCase();
                    const tech = (card.dataset.tech || "").toLowerCase();
                    const cardReg = card.dataset.reg || "";

                    const matchSearch = !query || title.includes(query) || tech.includes(query);
                    const matchReg = !reg || cardReg === reg;

                    if (matchSearch && matchReg) {
                        card.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        card.classList.add('d-none');
                    }
                });

                if (noResults) {
                    if (visibleCount === 0 && cards.length > 0) {
                        noResults.classList.remove('d-none');
                    } else {
                        noResults.classList.add('d-none');
                    }
                }
                if (resultCount) resultCount.textContent = visibleCount;
            }

            if(searchInput) searchInput.addEventListener('input', filterCards);
            if(regFilter) regFilter.addEventListener('change', filterCards);

            // Initial filter
            filterCards();
        });
    </script>
}
