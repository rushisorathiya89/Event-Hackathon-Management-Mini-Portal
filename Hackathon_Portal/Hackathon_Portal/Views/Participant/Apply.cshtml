@model Hackathon_Portal.Models.ViewModels.TeamRegistrationViewModel
@{
    ViewData["Title"] = "Apply to " + Model.HackathonTitle;
    Layout = "~/Views/_ParticipantLayout.cshtml";
    var maxTeamSize = ViewBag.MaxTeamSize ?? 4;
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="Hackathons" class="text-decoration-none text-navy fw-bold small">
            <i class="fas fa-arrow-left me-1"></i> Back to Hackathons
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-8 col-lg-10">
            <div class="form-container">
                <div class="card-header bg-navy text-white p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-rocket fs-4 text-orange"></i>
                    </div>
                    <div>
                        <h4 class="m-0 fw-bold" style="font-family: 'Poppins', sans-serif;">Register Your Team</h4>
                        <p class="m-0 small text-light" style="opacity: 0.8;">@Model.HackathonTitle</p>
                    </div>
                </div>

                <div class="form-container-body bg-white p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="background: #FFEBEE; color: #C62828; border: none;">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-action="Apply" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="HackathonId" />

                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" asp-for="TeamName">Team Name <span class="text-danger">*</span></label>
                                <input asp-for="TeamName" class="form-control form-control-lg bg-light" placeholder="e.g., Code Crushers" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" asp-for="ProjectTitle">Project Title <span class="text-danger">*</span></label>
                                <input asp-for="ProjectTitle" class="form-control form-control-lg bg-light" placeholder="e.g., Smart Campus App" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" asp-for="ProjectDescription">Project Description</label>
                                <textarea asp-for="ProjectDescription" class="form-control bg-light" rows="4" placeholder="Brief description of your project idea..."></textarea>
                            </div>

                            <!-- Team Members -->
                            <div class="col-12 mt-4 pt-3 border-top">
                                <label class="form-label fw-bold text-navy d-flex align-items-center mb-3">
                                    <i class="fas fa-users text-orange me-2"></i> Team Members (Max @maxTeamSize)
                                </label>
                                <div id="membersContainer" class="d-flex flex-column gap-3">
                                    <div class="d-flex gap-3 member-row align-items-center">
                                        <div class="flex-grow-1">
                                            <input name="Members[0].Name" class="form-control bg-light" placeholder="Member name" />
                                        </div>
                                        <div class="flex-grow-1">
                                            <input name="Members[0].Email" type="email" class="form-control bg-light" placeholder="Email Address" />
                                        </div>
                                    </div>
                                </div>
                                <button type="button" onclick="addMember()" id="addMemberBtn" class="btn btn-sm btn-outline-primary mt-3 border-dashed">
                                    <i class="fas fa-plus-circle me-1"></i> Add Member
                                </button>
                            </div>

                            <div class="col-12 mt-4 pt-3 border-top d-flex gap-3">
                                <button type="submit" class="btn btn-primary btn-lg px-5 flex-grow-1" style="background-color: #F4821F; border-color: #F4821F;">
                                    <i class="fas fa-paper-plane me-2"></i> Submit Registration
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let memberCount = 1;
        const maxMembers = @maxTeamSize;

        function addMember() {
            if (memberCount >= maxMembers) {
                alert('Maximum team size reached (' + maxMembers + ')');
                return;
            }
            const container = document.getElementById('membersContainer');
            const row = document.createElement('div');
            row.className = 'd-flex gap-3 member-row align-items-center';
            row.innerHTML = `
                <div class="flex-grow-1">
                    <input name="Members[${memberCount}].Name" class="form-control bg-light" placeholder="Member name" />
                </div>
                <div class="flex-grow-1">
                    <input name="Members[${memberCount}].Email" type="email" class="form-control bg-light" placeholder="Email Address" />
                </div>
                <div>
                    <button type="button" onclick="this.parentElement.parentElement.remove(); memberCount--;" class="btn btn-sm btn-outline-danger border-0">
                        <i class="fas fa-times-circle fs-5"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
            memberCount++;
        }
    </script>
}
