@model Hackathon_Portal.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var vm = Model ?? new Hackathon_Portal.Models.ParticipantProfileViewModel();
    var historyRows = vm.History?.ToList() ?? new List<Hackathon_Portal.Models.ParticipantHistoryItemViewModel>();
}

<div class="container py-4">
    <h1 class="h3 mb-4">My Profile</h1>

    <section class="mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">Current Status</h2>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="text-muted small">Current Team</div>
                            <div class="fw-semibold">@vm.CurrentTeamName</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded bg-light h-100">
                            <div class="text-muted small">Current Event</div>
                            <div class="fw-semibold">@vm.CurrentEventTitle</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">My Scores</h2>
                <div class="d-flex flex-wrap align-items-end gap-4">
                    <div>
                        <div class="display-6 fw-bold mb-0">@vm.AverageScore.ToString("0.00")</div>
                        <div class="text-muted small">Average Score Received</div>
                    </div>
                    <div>
                        <div class="h4 mb-0">@vm.ScoredSubmissionsCount</div>
                        <div class="text-muted small">Scored Submissions</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-3">History</h2>

                @if (!historyRows.Any())
                {
                    <div class="alert alert-info mb-0" role="alert">
                        No past participation history found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Past Events</th>
                                    <th scope="col">Team Name</th>
                                    <th scope="col" class="text-end">Final Rank</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in historyRows)
                                {
                                    <tr>
                                        <td>@item.PastEventTitle</td>
                                        <td>@item.TeamName</td>
                                        <td class="text-end">#@item.FinalRank</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>
</div>