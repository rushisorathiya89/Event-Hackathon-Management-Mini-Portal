@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Judges";
}

<div class="admin-surface">
    <div class="card admin-card">
        <div class="card-body p-4">
            <h1 class="h4 mb-3">Judges Directory</h1>
            <p class="text-secondary mb-4">Manage judge profiles and assignment load.</p>

            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Judge</th>
                        <th>Specialty</th>
                        <th>Assigned Events</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Alex Sterling</td><td>Cloud Infrastructure</td><td>1</td><td><span class="badge text-bg-success">Active</span></td></tr>
                    <tr><td>Maria Kova</td><td>Product Strategy</td><td>1</td><td><span class="badge text-bg-success">Active</span></td></tr>
                    <tr><td>James Hauer</td><td>Cybersecurity</td><td>2</td><td><span class="badge text-bg-warning">Busy</span></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>