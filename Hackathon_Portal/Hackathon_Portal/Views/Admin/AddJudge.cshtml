@{
    ViewData["Title"] = "Add Judge";
    Layout = "~/Views/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-6 col-lg-8">
            <div class="form-container">
                <div class="card-header bg-navy text-white p-4 d-flex align-items-center gap-3">
                    <div class="bg-white rounded d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-gavel fs-4 text-orange"></i>
                    </div>
                    <div>
                        <h4 class="m-0 fw-bold" style="font-family: 'Poppins', sans-serif;">Add New Judge</h4>
                        <p class="m-0 small text-light" style="opacity: 0.8;">Create judge credentials for evaluations</p>
                    </div>
                </div>

                <div class="form-container-body bg-white p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="background: #FFEBEE; color: #C62828; border: none;">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-action="AddJudge" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="row g-4">
                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" for="fullName">Full Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                    <input name="fullName" id="fullName" type="text" placeholder="Judge full name" required class="form-control form-control-lg bg-light border-start-0 ps-0" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" for="email">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                    <input name="email" id="email" type="email" placeholder="judge@example.com" required class="form-control form-control-lg bg-light border-start-0 ps-0" />
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-navy" for="password">Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                                    <input name="password" id="password" type="password" placeholder="Create a password" required minlength="6" class="form-control form-control-lg bg-light border-start-0 ps-0" />
                                </div>
                                <p class="small text-muted mt-2 mb-0">
                                    <i class="fas fa-info-circle me-1"></i> The judge will use this password to login.
                                </p>
                            </div>

                            <div class="col-12 mt-4 pt-3 border-top d-flex gap-3">
                                <button type="submit" class="btn btn-primary btn-lg px-5 flex-grow-1" style="background-color: #F4821F; border-color: #F4821F;">
                                    <i class="fas fa-user-plus me-2"></i> Create Judge Account
                                </button>
                                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-lg px-4">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
