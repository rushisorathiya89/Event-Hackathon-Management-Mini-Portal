@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Events";
}

<div class="admin-surface">
    <div class="card admin-card">
        <div class="card-body p-4">
            <h1 class="h4 mb-3">Events Management</h1>
            <p class="text-secondary mb-4">Create, edit, and publish hackathon events.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 rounded border bg-light-subtle">
                        <h2 class="h6">CodeBlast 2024</h2>
                        <p class="mb-2 text-muted">Registration Window: Jan 10 - Mar 12</p>
                        <span class="badge text-bg-success">Open</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded border bg-light-subtle">
                        <h2 class="h6">AI Forge 2025</h2>
                        <p class="mb-2 text-muted">Registration Window: Apr 01 - Jun 30</p>
                        <span class="badge text-bg-secondary">Draft</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>