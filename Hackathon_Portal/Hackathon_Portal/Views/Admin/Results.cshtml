@model Hackathon_Portal.Models.Hackathon
@{
    ViewData["Title"] = "Results - " + Model.Title;
    Layout = "~/Views/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <a asp-action="Hackathons" class="text-decoration-none text-primary" style="font-weight: 500;">
            <i class="fas fa-arrow-left me-1"></i> Back to Hackathons
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; border-left: 4px solid #1E3A6E !important;">
        <div class="card-body p-4 d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
                <i class="fas fa-trophy fs-3"></i>
            </div>
            <div>
                <h3 class="fw-bold text-navy m-0" style="font-family: 'Poppins', sans-serif;">@Model.Title &mdash; Results</h3>
                <p class="text-muted m-0 small">Leaderboard based on judge scores</p>
            </div>
        </div>
    </div>

    @if (Model.Teams == null || !Model.Teams.Any())
    {
        <div class="text-center p-5 bg-white rounded shadow-sm border border-light">
            <div class="d-inline-flex bg-light rounded-circle p-4 mb-3">
                <i class="fas fa-clipboard text-muted" style="font-size: 32px;"></i>
            </div>
            <h5 class="fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">No Teams Registered Yet</h5>
            <p class="text-muted">Wait for participants to register.</p>
        </div>
    }
    else
    {
        var rankedTeams = Model.Teams
            .Select(t => new {
                Team = t,
                Total = t.Scores != null && t.Scores.Any()
                    ? t.Scores.Sum(s => s.Innovation + s.Execution + s.Presentation)
                    : 0,
                Scored = t.Scores != null && t.Scores.Any()
            })
            .OrderByDescending(x => x.Total)
            .ToList();

        <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3 fw-bold border-0 text-center">Rank</th>
                            <th class="py-3 fw-bold border-0">Team</th>
                            <th class="py-3 fw-bold border-0">Project</th>
                            <th class="py-3 fw-bold border-0">Leader</th>
                            <th class="py-3 fw-bold border-0 text-center">Innovation</th>
                            <th class="py-3 fw-bold border-0 text-center">Execution</th>
                            <th class="py-3 fw-bold border-0 text-center">Presentation</th>
                            <th class="pe-4 py-3 fw-bold border-0 text-center">Total</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @{ int rank = 1; }
                        @foreach (var item in rankedTeams)
                        {
                            var score = item.Team.Scores?.FirstOrDefault();
                            var rowClass = rank <= 3 ? "bg-warning bg-opacity-10" : "";
                            
                            <tr class="transition @rowClass">
                                <td class="ps-4 py-4 text-center">
                                    @if (rank == 1)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-warning bg-white shadow-sm" style="width: 40px; height: 40px;">
                                            <span class="fs-4">🥇</span>
                                        </div>
                                    }
                                    else if (rank == 2)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-secondary bg-white shadow-sm" style="width: 40px; height: 40px;">
                                            <span class="fs-4">🥈</span>
                                        </div>
                                    }
                                    else if (rank == 3)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border" style="width: 40px; height: 40px; border-color: #cd7f32; background-color: #fff; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);">
                                            <span class="fs-4">🥉</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">#@rank</span>
                                    }
                                </td>
                                <td class="py-4 fw-bold text-navy" style="font-family: 'Poppins', sans-serif;">@item.Team.TeamName</td>
                                <td class="py-4"><span class="text-dark fw-medium small">@item.Team.ProjectTitle</span></td>
                                <td class="py-4 text-muted small">@item.Team.Leader?.FullName</td>
                                <td class="py-4 text-center">
                                    <span class="badge bg-light text-dark border w-50 py-2">@(score?.Innovation.ToString() ?? "-")</span>
                                </td>
                                <td class="py-4 text-center">
                                    <span class="badge bg-light text-dark border w-50 py-2">@(score?.Execution.ToString() ?? "-")</span>
                                </td>
                                <td class="py-4 text-center">
                                    <span class="badge bg-light text-dark border w-50 py-2">@(score?.Presentation.ToString() ?? "-")</span>
                                </td>
                                <td class="pe-4 py-4 text-center">
                                    @if (item.Scored)
                                    {
                                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded shadow-sm fw-bold" style="width: 45px; height: 45px; font-size: 1.1rem;">
                                            @item.Total
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill fw-normal">Pending</span>
                                    }
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
