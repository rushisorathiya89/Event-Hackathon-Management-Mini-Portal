@model IEnumerable<Hackathon_Portal.Models.JudgingIndexItemViewModel>

@{
    ViewData["Title"] = "Judging Dashboard";

    var items = Model?.ToList() ?? new List<Hackathon_Portal.Models.JudgingIndexItemViewModel>();
    var totalTeams = items.Count;
    var scoredTeams = items.Count(i => i.HasScore);
    var scoredPercent = totalTeams == 0 ? 0 : (int)Math.Round((double)scoredTeams * 100 / totalTeams);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Judging Dashboard</h1>
        <span class="text-muted">@scoredTeams / @totalTeams teams scored</span>
    </div>

    <div class="mb-4">
        <div class="progress" role="progressbar" aria-label="Teams scored" aria-valuenow="@scoredPercent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar bg-success" style="width: @scoredPercent%;">@scoredPercent%</div>
        </div>
    </div>

    @if (!User.IsInRole("Judge"))
    {
        <div class="alert alert-warning" role="alert">
            This page is intended for users in the Judge role.
        </div>
    }

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            No teams are currently assigned for judging.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Team Name</th>
                        <th scope="col">Project Title</th>
                        <th scope="col" class="text-center">GitHub Link</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.TeamName</td>
                            <td>@item.ProjectTitle</td>
                            <td class="text-center">
                                <a href="@item.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm" title="Open GitHub repository">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M8 0C3.58 0 0 3.58 0 8a8.001 8.001 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.001 8.001 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                                    </svg>
                                </a>
                            </td>
                            <td>
                                @if (item.HasScore)
                                {
                                    <span class="text-success fw-semibold">&#10003; Scored</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Judging" asp-action="ScoreTeam" asp-route-teamId="@item.TeamId" class="btn btn-success btn-sm">
                                    Add Score
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>