@model IEnumerable<Hackathon_Portal.Models.Event>

@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Events";
}

<section class="portal-events py-5">
<div class="container-xl">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="portal-events-title mb-1">Ongoing &amp; Upcoming Hackathons</h1>
            <p class="portal-events-subtitle mb-0">Track live progress of ongoing competitions or secure your spot in upcoming innovation challenges.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Add New Event</a>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            No events found.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var shortDescription = string.IsNullOrWhiteSpace(item.Description)
                    ? "No description available yet."
                    : (item.Description.Length > 120 ? $"{item.Description[..120]}..." : item.Description);

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 portal-event-card border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="portal-event-date"><span aria-hidden="true">&#128197;</span> @item.StartDate:dd MMM - @item.EndDate:dd MMM</span>
                                @if (item.IsRegistrationOpen)
                                {
                                    <span class="badge rounded-pill text-bg-success">Registration Open</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-danger">Closed</span>
                                }
                            </div>

                            <h2 class="h4 portal-event-heading">@item.Title</h2>
                            <p class="portal-event-description text-muted">@shortDescription</p>

                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
</section>